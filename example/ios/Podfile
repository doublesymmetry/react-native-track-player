# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TrackPlayerExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix glog build failure under Swift/Clang module interop (react-native-video's
    # NitroModules dependency + Xcode 16+): "import of module 'glog.glog.log_severity'
    # appears within namespace 'google'".
    #
    # CocoaPods generates a glog modulemap with per-header submodules
    # (`module * { export * }`), but glog/logging.h textually #includes
    # log_severity.h and vlog_is_on.h *inside* `namespace google { ... }`. That's
    # legal for textual includes, but NitroModules' public Swift modulemap pulls in
    # React renderer headers -> react_native_assert.h -> <glog/logging.h>, forcing
    # Swift's Clang importer to build glog as a real module. The namespaced include
    # then becomes an illegal submodule import.
    #
    # Excluding log_severity.h / vlog_is_on.h from the glog module keeps every
    # include of them textual (as they're designed to be used), while glog is still
    # otherwise importable as a module (e.g. `#include <glog/logging.h>`).
    glog_modulemap = File.join(installer.sandbox.root, 'Target Support Files', 'glog', 'glog.modulemap')
    if File.exist?(glog_modulemap)
      File.write(glog_modulemap, <<~MODULEMAP)
        module glog {
          umbrella header "glog-umbrella.h"
          exclude header "glog/log_severity.h"
          exclude header "glog/vlog_is_on.h"
          export *
        }
      MODULEMAP
    end
  end
end
